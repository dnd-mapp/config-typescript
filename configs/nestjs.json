{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./node.json",
    "compilerOptions": {
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "useDefineForClassFields": false,
        "verbatimModuleSyntax": true
    }
}
