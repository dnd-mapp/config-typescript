{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@dnd-mapp/config-typescript",
  "description": "Shared, reusable TypeScript configs (tsconfig bases) for all D&D Mapp projects.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "author": "D&D Mapp",
  "keywords": [
    "tsconfig",
    "typescript",
    "config",
    "shareable-config",
    "dnd-mapp"
  ],
  "homepage": "https://github.com/dnd-mapp/config-typescript#readme",
  "bugs": {
    "url": "https://github.com/dnd-mapp/config-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/config-typescript.git"
  },
  "exports": {
    "./*": "./configs/*.json",
    "./*.json": "./configs/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "prepublishOnly": "node scripts/prepare-dist.js",
    "lint-md": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w .",
    "format-check": "prettier -c ."
  },
  "engines": {
    "node": "^24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@dnd-mapp/config-markdown": "catalog:markdown",
    "@dnd-mapp/config-prettier": "catalog:prettier",
    "@types/node": "catalog:",
    "markdownlint-cli2": "catalog:markdown",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
